# Fernet key — encrypts passwords and connection strings stored in the Airflow DB.
# This value must stay the same across container restarts.
# To generate your own:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=tralala

# Secret key for signing web session cookies. Change this to any random string.
SECRET_KEY=dingdingdong

# Airflow web UI login credentials
AIRFLOW_WWW_USER_USERNAME=nevergonnagiveyouup
AIRFLOW_WWW_USER_PASSWORD=nevergonnaletyoudown

# Yeah you've just been rickrolled :) Change the above values to something more secure before using Airflow in production!

POSTGRES_USER=write_something_secure_here
POSTGRES_PASSWORD=write_something_secure_here
POSTGRES_DB=write_something_secure_here